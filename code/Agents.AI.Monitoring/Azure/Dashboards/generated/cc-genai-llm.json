{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cost & throughput",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "LLM token usage (input/output)",
      "description": "Token consumption rate by type, from the GenAI client token-usage histogram.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 25,
            "lineWidth": 1,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "showPoints": "never",
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "sum(rate(gen_ai_client_token_usage_tokens_sum[$__rate_interval])) by (gen_ai_token_type)",
          "legendFormat": "{{gen_ai_token_type}} tokens/s",
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "LLM operation duration (p50/p95/p99)",
      "description": "GenAI client operation latency percentiles, from OpenTelemetryConversationSession.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "min",
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(gen_ai_client_operation_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(gen_ai_client_operation_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(gen_ai_client_operation_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Realtime turn latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Time to first audio (p50/p95/p99)",
      "description": "Latency from session start to first outbound audio/directive, from CallingTelemetry TTFA histogram.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "min",
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(contact_center_call_time_to_first_audio_milliseconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(contact_center_call_time_to_first_audio_milliseconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(contact_center_call_time_to_first_audio_milliseconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Edge dispatch latency (p95)",
      "description": "Per-directive dispatch latency p95 by edge, from CallingTelemetry.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(contact_center_edge_dispatch_latency_milliseconds_bucket[$__rate_interval])) by (le, edge))",
          "legendFormat": "{{edge}} p95",
          "range": true
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "contact-center",
    "genai",
    "llm",
    "realtime"
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "label": "Azure Monitor",
        "query": "grafana-azure-monitor-datasource",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1
      },
      {
        "name": "prom",
        "type": "datasource",
        "label": "Managed Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1
      },
      {
        "name": "law",
        "type": "textbox",
        "label": "Log Analytics workspace resource id",
        "current": {
          "text": "",
          "value": ""
        },
        "query": "",
        "hide": 0
      },
      {
        "name": "e2e",
        "type": "textbox",
        "label": "e2e.call_id",
        "description": "Canonical end-to-end call id. Leave blank for fleet views; set to trace a single call.",
        "current": {
          "text": "",
          "value": ""
        },
        "query": "",
        "hide": 0
      },
      {
        "name": "ns",
        "type": "textbox",
        "label": "Kubernetes namespace",
        "description": "Namespace/regex for cAdvisor resource panels. Blank matches all.",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "query": ".*",
        "hide": 0
      },
      {
        "name": "org",
        "type": "textbox",
        "label": "Organization / workstream",
        "description": "Optional filter carried on telemetry as d365.workstream / call.tenant. Blank matches all.",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "query": ".*",
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Contact Center — GenAI & Realtime",
  "uid": "cc-genai-llm",
  "version": 1
}
