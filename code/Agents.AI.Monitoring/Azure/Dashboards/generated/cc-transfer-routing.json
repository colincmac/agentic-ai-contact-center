        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1
      },
      {
        "name": "law",
        "type": "textbox",
        "label": "Log Analytics workspace resource id",
        "current": {
          "text": "",
          "value": ""
        },
        "query": "",
        "hide": 0
      },
      {
        "name": "e2e",
        "type": "textbox",
        "label": "e2e.call_id",
        "description": "Canonical end-to-end call id. Leave blank for fleet views; set to trace a single call.",
        "current": {
