{
  "__meta": "REUSABLE. Quality alerts from Managed Prometheus counters contact_center.quality.alerts.raised / .resolved, by kind+severity. Bars raised vs resolved — the alert-activity archetype, retargeted at CallingTelemetry quality alerts.",
  "type": "timeseries",
  "title": "Call-quality alerts (raised vs resolved)",
  "description": "Quality alerts raised and resolved per second, by kind. A persistent gap (raised > resolved) means alerts are accumulating.",
  "datasource": { "type": "prometheus", "uid": "${prom}" },
  "fieldConfig": {
    "defaults": {
      "color": { "mode": "palette-classic" },
      "custom": {
        "drawStyle": "bars",
        "fillOpacity": 30,
        "lineWidth": 1,
        "showPoints": "never",
        "axisPlacement": "auto",
        "thresholdsStyle": { "mode": "off" }
      },
      "mappings": [],
      "min": 0,
      "unit": "none"
    },
    "overrides": [
      {
        "matcher": { "id": "byFrameRefID", "options": "B" },
        "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ]
      }
    ]
  },
  "options": {
    "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true },
    "tooltip": { "mode": "multi", "sort": "desc" }
  },
  "targets": [
    {
      "refId": "A",
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "editorMode": "code",
      "expr": "sum(rate(contact_center_quality_alerts_raised_total[$__rate_interval])) by (kind)",
      "legendFormat": "raised — {{kind}}",
      "range": true
    },
    {
      "refId": "B",
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "editorMode": "code",
      "expr": "sum(rate(contact_center_quality_alerts_resolved_total[$__rate_interval]))",
      "legendFormat": "resolved",
      "range": true
    }
  ]
}
