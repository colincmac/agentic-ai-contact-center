{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contact Center Call Workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "initialStage", "stages"],
  "properties": {
    "schemaVersion": { "const": 1, "default": 1 },
    "id": { "type": "string", "minLength": 1, "pattern": "^[^@]+$" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "description": { "type": "string" },
    "basePrompt": { "type": "string" },
    "commonTools": { "$ref": "#/$defs/names" },
    "initialStage": { "type": "string", "minLength": 1 },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" } }
  },
  "$defs": {
    "names": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "goal": { "type": "string" },
        "description": { "type": "string" },
        "terminal": { "type": "boolean" },
        "terminalOutcome": { "enum": ["none", "success", "failure", "escalated", "abandoned"] },
        "exitWhen": { "type": "string" },
        "tools": { "$ref": "#/$defs/names" },
        "interactionProfiles": { "$ref": "#/$defs/names" },
        "onInputFailure": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "onActionSuccess": { "type": "string", "minLength": 1 },
        "onActionFailure": { "type": "string", "minLength": 1 },
        "authenticate": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "use": { "type": "string", "minLength": 1 },
              "anyOf": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            },
            "oneOf": [{ "required": ["use"] }, { "required": ["anyOf"] }]
          }
        },
        "onAuthenticationFailure": { "type": "string", "minLength": 1 },
        "maxAuthenticationAttempts": { "type": "integer", "minimum": 1, "default": 3 },
        "authenticationMaxAgeSeconds": { "type": "integer", "minimum": 1, "default": 300 },
        "realtime": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "instructions": { "$ref": "#/$defs/names" },
            "examples": { "$ref": "#/$defs/names" },
            "tools": { "$ref": "#/$defs/names" }
          }
        },
        "nlu": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "instructions": { "type": "string" },
            "intents": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["name", "transition"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "transition": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "scripted": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "ssml": { "type": "string" },
            "audioFile": { "type": "string", "pattern": "^https://" },
            "menu": {
              "type": "object",
              "propertyNames": { "pattern": "^[0-9*#ABCD]$" },
              "additionalProperties": {
                "type": "object", "additionalProperties": false, "required": ["transition"],
                "properties": {
                  "label": { "type": "string" },
                  "transition": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } }
      },
      "dependentRequired": {
        "authenticate": ["onAuthenticationFailure"],
        "action": ["onActionSuccess", "onActionFailure"]
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["to"],
      "properties": {
        "to": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "when": { "type": "string" },
        "requires": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type"],
            "properties": {
              "type": { "enum": ["auth", "state", "predicate"] },
              "level": { "enum": ["none", "aniMatch", "knowledgeBased", "multiFactor", "voiceBiometric", "entraVerifiedId", "strong"] },
              "key": { "type": "string", "minLength": 1 },
              "equals": {},
              "id": { "type": "string", "minLength": 1 },
              "message": { "type": "string" }
            },
            "allOf": [
              { "if": { "properties": { "type": { "const": "auth" } } }, "then": { "required": ["level"] } },
              { "if": { "properties": { "type": { "const": "state" } } }, "then": { "required": ["key"] } },
              { "if": { "properties": { "type": { "const": "predicate" } } }, "then": { "required": ["id"] } }
            ]
          }
        }
      }
    }
  }
}
